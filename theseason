#!/bin/bash

declare -r BLUE='\033[0;34m'
declare -r GREEN='\033[0;32m'
declare -r YELLOW='\033[1;33m'
declare -r LIGHT_BLUE='\033[1;34m'
declare -r LIGHT_GREEN='\033[1;32m'
declare -r LIGHT_YELLOW='\033[1;33m'
declare -r LIGHT_RED='\033[1;31m'
declare -r LIGHT_CYAN='\033[1;36m'
declare -r NC='\033[0m' # No color

# -----------------------------------------------------------------------------
# TOKEN: se lee de un archivo en la misma carpeta (.htb_token)
# Crea el archivo una vez con:  echo "TU_TOKEN" > .htb_token && chmod 600 .htb_token
# -----------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOKEN_FILE="$SCRIPT_DIR/.htb_token"

handle_interrupt() {
    echo
    read -rp "Are you sure you want to exit? (y/n): " confirm
    if [ "$confirm" == "y" ]; then
        exit 0
    fi
}

# Assign the interrupt signal handling function to the SIGINT signal (CTRL+C)
trap handle_interrupt SIGINT

figlet The Player
echo -e "${LIGHT_RED}            Season Version${NC}"

# check openvpn
if pgrep -x "openvpn" > /dev/null; then
    echo -e "${LIGHT_GREEN}[+] OpenVPN is running.${NC}"
else
    echo -e "${LIGHT_RED}[!] OpenVPN is not running. Connect the VPN.${NC}"
    exit 1
fi

# check token file
if [ ! -f "$TOKEN_FILE" ]; then
    echo -e "\n${LIGHT_RED}[!] No existe el archivo de token: $TOKEN_FILE${NC}"
    echo -e "${LIGHT_BLUE}[i] Créalo con: echo \"TU_TOKEN\" > .htb_token && chmod 600 .htb_token${NC}\n"
    exit 1
fi

TOKEN=$(tr -d '[:space:]' < "$TOKEN_FILE")

if [ -z "$TOKEN" ]; then
    echo -e "\n${LIGHT_RED}[!] El archivo de token está vacío: $TOKEN_FILE${NC}\n"
    exit 1
fi

# -----------------------------------------------------------------------------
# Decodificación robusta de JWT (base64url + padding) para la fecha de caducidad
# -----------------------------------------------------------------------------
decode_jwt_part() {
    local part=$1
    local mod=$(( ${#part} % 4 ))
    if   [ "$mod" -eq 2 ]; then part="${part}=="
    elif [ "$mod" -eq 3 ]; then part="${part}="
    fi
    echo "$part" | tr '_-' '/+' | base64 -d 2>/dev/null
}

payload=$(decode_jwt_part "$(echo "$TOKEN" | awk -F'.' '{print $2}')")
expiration_unix_timestamp=$(echo "$payload" | jq -r '.exp')
if [ -n "$expiration_unix_timestamp" ] && [ "$expiration_unix_timestamp" != "null" ]; then
    expiration_date=$(date -d @"$expiration_unix_timestamp")
    echo -e "\n${BLUE}[i] Your token expiration date is: $expiration_date${NC}"
    now=$(date +%s)
    if [ "$now" -ge "$expiration_unix_timestamp" ]; then
        echo -e "${LIGHT_RED}[!] El token ha CADUCADO. Renuévalo en app.hackthebox.com.${NC}"
        exit 1
    fi
else
    echo -e "\n${LIGHT_YELLOW}[!] No se pudo leer la fecha de caducidad del token (¿formato correcto?).${NC}"
fi

echo -e "\n${YELLOW}[+] Spawn Machine... ${NC}"

active_machine_id=$(curl -s -k --compressed -X 'GET' \
-H 'Host: labs.hackthebox.com' \
-H 'User-Agent: ThePlayer' \
-H 'Accept: application/json, text/plain, */*' \
-H 'Accept-Language: es-ES,es;q=0.8,en-US;q=0.5,en;q=0.3' \
-H 'Accept-Encoding: gzip, deflate, br' \
-H "Authorization: Bearer $TOKEN" \
-H 'Origin: https://app.hackthebox.com' \
-H 'Referer: https://app.hackthebox.com/' \
'https://labs.hackthebox.com/api/v4/season/machine/active' | jq -r '.data.id')

curl -s -k --compressed -X 'POST' \
-H 'Host: labs.hackthebox.com' \
-H 'User-Agent: ThePlayer' \
-H "Authorization: Bearer $TOKEN" \
-H 'Origin: https://app.hackthebox.com' \
-H 'Referer: https://app.hackthebox.com/' \
-H 'Content-Type: application/json' \
--data-binary '{"machine_id":'"$active_machine_id"'}' \
'https://labs.hackthebox.com/api/v4/vm/spawn' | jq . -r

echo -e "\n${YELLOW}[+] Machine info:${NC}"

json_response_season=$(curl -s -k --compressed -X 'GET' \
-H 'Host: labs.hackthebox.com' \
-H 'User-Agent: ThePlayer' \
-H 'Accept: application/json, text/plain, */*' \
-H "Authorization: Bearer $TOKEN" \
-H 'Origin: https://app.hackthebox.com' \
-H 'Referer: https://app.hackthebox.com/' \
'https://labs.hackthebox.com/api/v4/season/machine/active')

ipvictima=$(echo "$json_response_season" | jq -r '.data.ip')
nombre=$(echo "$json_response_season" | jq -r '.data.name')
iddelamaquina=$(echo "$json_response_season" | jq -r '.data.id')

echo -e "${LIGHT_GREEN}[+]         IP: $ipvictima ${NC}"
echo -e "${LIGHT_GREEN}[+]    Machine: $nombre ${NC}"
echo -e "${LIGHT_GREEN}[+]         ID: $iddelamaquina ${NC}\n"

# -----------------------------------------------------------------------------
# Ping + captura del TTL para primera pista de OS
# -----------------------------------------------------------------------------
echo -e "${LIGHT_BLUE}[i] Ping Machine IP... ${NC}"
ttl=""
while [ -z "$ttl" ]; do
    ping_out=$(ping -c 1 -W 2 "$ipvictima" 2>/dev/null)
    if echo "$ping_out" | grep -q 'ttl='; then
        ttl=$(echo "$ping_out" | grep -oP 'ttl=\K[0-9]+' | head -1)
    else
        echo "Ping unsuccessful. Retrying in 1 second..."
        sleep 1
    fi
done

detectar_os() {
    local t=$1
    if   [ "$t" -le 64 ];  then echo "Linux"
    elif [ "$t" -le 128 ]; then echo "Windows"
    else echo "Desconocido/Red"; fi
}
OS=$(detectar_os "$ttl")
echo -e "${LIGHT_GREEN}[+] TTL=$ttl  ->  OS probable (por TTL): $OS${NC}"

## Artificial host add
echo -e "${LIGHT_GREEN}[i] Added in /etc/hosts: $ipvictima $nombre.htb ${NC}"
echo "$ipvictima $nombre.htb" | sudo tee -a /etc/hosts >/dev/null

## Fast Scan and full port scan
echo -e "${LIGHT_BLUE}[+] Fast nmap scan \n ${NC}"
sudo nmap -T4 -F "$ipvictima"
echo -e "${LIGHT_YELLOW}\n[i] While the tests are running you can check the above ports.${NC}"
echo -e "${LIGHT_BLUE}[i] Testing all ports... ${NC}"

ports=$(nmap -p- -n -Pn --min-rate=3000 "$ipvictima" | grep "^[0-9]" | cut -d '/' -f 1 | tr '\n' ',' | sed s/,$//)
echo -e "${LIGHT_BLUE}[+] Ports open: ${NC}"
echo -e "${LIGHT_GREEN}[+] $ports ${NC}"
echo "$ports" > portsnmap

# -----------------------------------------------------------------------------
# Clasificación de servicios -> flags
# -----------------------------------------------------------------------------
tiene() { echo ",$ports," | grep -q ",$1,"; }

HAS_WEB=false; HAS_SMB=false; HAS_AD=false; HAS_FTP=false
HAS_SSH=false; HAS_DNS=false; HAS_RDP=false; HAS_WINRM=false; HAS_DB=false

for p in 80 443 8080 8443 8000 8888 3000 5000; do tiene "$p" && HAS_WEB=true; done
for p in 139 445; do tiene "$p" && HAS_SMB=true; done
for p in 88 389 636 3268 464; do tiene "$p" && HAS_AD=true; done
tiene 21   && HAS_FTP=true
tiene 22   && HAS_SSH=true
tiene 53   && HAS_DNS=true
tiene 3389 && HAS_RDP=true
for p in 5985 5986; do tiene "$p" && HAS_WINRM=true; done
for p in 3306 5432 1433 27017 6379; do tiene "$p" && HAS_DB=true; done

# Refinar OS con puertos (más fiable que el TTL)
if $HAS_RDP || $HAS_WINRM || $HAS_AD; then
    OS="Windows"
fi

# -----------------------------------------------------------------------------
# Plan de ataque adaptado
# -----------------------------------------------------------------------------
echo -e "\n${LIGHT_CYAN}========================================${NC}"
echo -e "${LIGHT_CYAN}          PLAN DE ATAQUE${NC}"
echo -e "${LIGHT_CYAN}========================================${NC}"
echo -e "${LIGHT_GREEN}[+] OS estimado: $OS${NC}"

if [ "$OS" == "Windows" ]; then
    echo -e "${LIGHT_YELLOW}[>] Enfoque Windows/AD:${NC}"
    $HAS_AD    && echo -e "    - AD detectado (Kerberos/LDAP): enumera users con kerbrute, prueba AS-REP roasting, bloodhound-python."
    $HAS_SMB   && echo -e "    - SMB: null/guest session, shares, RID brute, vulns (netexec)."
    $HAS_WINRM && echo -e "    - WinRM (5985): guarda credenciales para evil-winrm."
    $HAS_RDP   && echo -e "    - RDP (3389): xfreerdp cuando tengas credenciales."
else
    echo -e "${LIGHT_YELLOW}[>] Enfoque Linux/Unix:${NC}"
    $HAS_SSH && echo -e "    - SSH: guarda para acceso; revisa claves/credenciales que encuentres."
fi

$HAS_WEB && echo -e "${LIGHT_YELLOW}[>] Servicio WEB detectado: fuzzing de dirs/vhosts, revisa tecnologías (whatweb).${NC}"
$HAS_FTP && echo -e "${LIGHT_YELLOW}[>] FTP (21): prueba login anónimo.${NC}"
$HAS_DNS && echo -e "${LIGHT_YELLOW}[>] DNS (53): intenta transferencia de zona / enum.${NC}"
$HAS_DB  && echo -e "${LIGHT_YELLOW}[>] Base de datos expuesta: prueba credenciales por defecto.${NC}"
echo -e "${LIGHT_CYAN}========================================${NC}\n"

echo -e "${LIGHT_BLUE}[+] NMAP -sV -sC -Pn launched in background\n${NC}"
nmap -p"$ports" -sV -sC -Pn "$ipvictima" -oX ResultNmap"$nombre" &

echo -e "${LIGHT_BLUE}[i] Continue testing...\n${NC}"

# -----------------------------------------------------------------------------
# WEB (80)
# -----------------------------------------------------------------------------
if $HAS_WEB && tiene 80; then
    echo -e "${YELLOW}[+] Puerto 80 abierto en $ipvictima${NC}\n"
    echo -e "-----------------------"
    echo -e "${LIGHT_CYAN}[+] Curl a $ipvictima guardado en curl80${NC}"
    echo -e "${LIGHT_BLUE}gobuster dir -w /usr/share/wordlists/seclists/Discovery/Web-Content/raft-small-words.txt -k -b 404 -t 100 -u http://$nombre.htb/ -o gobuster.dir.out${NC}\n"
    echo -e "${LIGHT_BLUE}gobuster vhost -w /usr/share/seclists/Discovery/DNS/subdomains-top1million-5000.txt -k -u http://$nombre.htb -o gobuster.vhost.out${NC}\n"
    echo "-----------------------"
    curl -s -L -k "$ipvictima" -o "curl80"
    echo -e "${YELLOW}\n[+] Posible app:${NC}"
    command -v whatweb >/dev/null && whatweb -q "http://$ipvictima" 2>/dev/null
    curl -s -L -k "$ipvictima" | grep -i -E "Powered by|X-Powered-By|generator|content=" | head -5
    xdg-open "http://$ipvictima" &
fi

# -----------------------------------------------------------------------------
# WEB (443)
# -----------------------------------------------------------------------------
if $HAS_WEB && tiene 443; then
    echo -e "${YELLOW}\n[+] Puerto 443 abierto en $nombre, revisa certificados por subdominios\n${NC}"
    echo -e "-----------------------"
    echo -e "${LIGHT_CYAN}[+] Curl a $ipvictima guardado en curl443${NC}"
    echo -e "${GREEN}gobuster dir -w /usr/share/wordlists/seclists/Discovery/Web-Content/raft-small-words.txt -k -b 404 -t 100 -u https://$nombre.htb/ -o gobuster.dir.out${NC}\n"
    echo -e "${GREEN}gobuster vhost -w /usr/share/seclists/Discovery/DNS/subdomains-top1million-5000.txt -k -u https://$nombre.htb -o gobuster.vhost.out${NC}\n"
    echo "-----------------------"
    curl -s -k -L "https://$ipvictima" -o "curl443"
    echo -e "${YELLOW}\n[+] Posible app:${NC}"
    command -v whatweb >/dev/null && whatweb -q "https://$ipvictima" 2>/dev/null
    curl -s -L -k "https://$ipvictima" | grep -i -E "Powered by|X-Powered-By|generator|content=" | head -5
    xdg-open "https://$ipvictima" &
fi

# -----------------------------------------------------------------------------
# SMB (139/445)
# -----------------------------------------------------------------------------
if $HAS_SMB; then
    echo -e "${GREEN}\n[+] 139 o 445 abierto en $ipvictima\n${NC}"
    echo -e "${YELLOW}[-] Enumeración SMB/LDAP/RPC sin credenciales (enum4linux-ng):\n${NC}"
    enum4linux-ng -Adv "$ipvictima"
    echo "-----------------------"
    echo -e "${YELLOW}[-] smbclient:${NC}"
    smbclient -N -L //"$ipvictima"
    netexec smb "$ipvictima"
    echo -e "${YELLOW}[-] NetExec (guest) shares:${NC}"
    nxc smb "$ipvictima" -u 'guest' -p '' --shares
    echo -e "-----------------------\n"
    echo -e "${YELLOW}[-] NetExec shares filtrando READ/WRITE:${NC}"
    nxc smb "$ipvictima" -u 'guest' -p '' --shares --filter-shares READ WRITE
    echo -e "-----------------------\n"
    nxc smb "$ipvictima" -u 'guest' -p '' --rid-brute 10000
    echo -e "-----------------------\n"
    echo -e "${LIGHT_BLUE}[i] NetExec módulos de vulns:${NC}"
    nxc smb "$ipvictima" -u 'guest' -p '' -M shadowcoerce -M petitpotam -M dfscoerce
fi

echo -e "${LIGHT_BLUE}\n[i] Esperando el escaneo Nmap en segundo plano... sonará un aviso al terminar.${NC}"
wait
paplay /usr/share/sounds/freedesktop/stereo/complete.oga 2>/dev/null

# -----------------------------------------------------------------------------
# Hostnames -> /etc/hosts
# -----------------------------------------------------------------------------
echo "-----------------------"
echo -e "${LIGHT_BLUE}[i] Buscando hostnames para añadir a /etc/hosts...${NC}"
echo "-----------------------"

tempfile=$(mktemp)
xmllint --xpath '//host/ports/port/script[@id="http-title" and @output!=""]/@output' ResultNmap"$nombre" 2>/dev/null | sed -n -E 's/.*(https?|http):\/\/([^/]+).*/\2/p' > "$tempfile"

declare -A uniqueHostnames
while IFS= read -r hostname; do
    if [ -n "$hostname" ] && [ -z "${uniqueHostnames["$hostname"]}" ]; then
        xdg-open "http://$hostname" &
        disown
        uniqueHostnames["$hostname"]=1
        if ! grep -q "$hostname" /etc/hosts; then
            echo -e "${LIGHT_BLUE}[i] Adding ${LIGHT_GREEN}$hostname${LIGHT_BLUE} to /etc/hosts${NC}"
            echo "$ipvictima $hostname # added by theseason" | sudo tee -a /etc/hosts >/dev/null
        else
            echo -e "${LIGHT_BLUE}[i] Ya existe en /etc/hosts, se omite${NC}"
        fi
    else
        echo -e "${LIGHT_BLUE}[i] Se omite (duplicado o vacío)${NC}"
    fi
done < "$tempfile"

if [ -s "$tempfile" ]; then
    echo -e "${LIGHT_BLUE}\n[i] Hostnames encontrados:${NC}"
    while IFS= read -r hostname; do
        echo -e "${LIGHT_GREEN}$hostname${NC}"
    done < "$tempfile"
else
    echo -e "${LIGHT_CYAN}\n[-] No se encontraron hostnames en Nmap.${NC}"
fi
rm "$tempfile"

# -----------------------------------------------------------------------------
# FTP (21) - login anónimo
# -----------------------------------------------------------------------------
if $HAS_FTP; then
    foldername="ftp$nombre"
    port_info=$(xmllint --xpath '//port[@portid="21" and state/@state="open"]' ResultNmap"$nombre" 2>/dev/null)
    if [[ -n $port_info ]]; then
        anon_login=$(echo "$port_info" | grep -o 'Anonymous FTP login allowed')
        if [[ -n $anon_login ]]; then
            echo -e "${LIGHT_BLUE}[i] Puerto 21 abierto con login anónimo permitido.${NC}"
            echo -e "${LIGHT_BLUE}[i] Descargando contenido FTP...${NC}"
            wget --user=anonymous --password=anonymous -r "ftp://$ipvictima" -P "$foldername"
            echo -e "${LIGHT_GREEN}Contenido FTP descargado en $foldername${NC}"
        else
            echo -e "${BLUE}[i] Puerto 21 abierto pero sin login anónimo.${NC}"
        fi
    fi
fi

# -----------------------------------------------------------------------------
# DNS (53)
# -----------------------------------------------------------------------------
if $HAS_DNS; then
    echo -e "${LIGHT_BLUE}\n[i] Puerto 53 DNS abierto, banner grab y módulos metasploit${NC}\n"
    dig version.bind CHAOS TXT @"$ipvictima"
    msfconsole -q -x "use auxiliary/scanner/dns/dns_amp; set RHOSTS $ipvictima; set RPORT 53; run; exit"
    msfconsole -q -x "use auxiliary/gather/enum_dns; set RHOSTS $ipvictima; set RPORT 53; run; exit"
fi

# -----------------------------------------------------------------------------
# VHOST fuzz (solo si hay web)
# -----------------------------------------------------------------------------
if $HAS_WEB; then
    echo -e "${LIGHT_BLUE}\n[i] VHOST Scan (CTRL+C para salir)${NC}\n"
    ffuf -c -u "http://$nombre.htb" -H "Host: FUZZ.$nombre.htb" -w /usr/share/seclists/Discovery/DNS/n0kovo_subdomains.txt -fc 301 -t 200
    echo -e "${LIGHT_BLUE}\n[i] ...sonará un aviso al terminar.${NC}"
    paplay /usr/share/sounds/freedesktop/stereo/complete.oga 2>/dev/null
fi

echo -e "${YELLOW}\n[+] Bye...${NC}"
